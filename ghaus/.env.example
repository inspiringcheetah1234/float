# Local values come from `npm run db:start` (printed at the end). Production: Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to create staff logins and (Phase 3) read credential ciphertext after permission checks.
SUPABASE_SERVICE_ROLE_KEY=
# Phase 3: 32 random bytes, base64 (openssl rand -base64 32). Losing it makes stored credentials unrecoverable.
CREDENTIALS_ENCRYPTION_KEY=
# Phase 4
ANTHROPIC_API_KEY=
# Set to "true" to let anyone create a new firm at /signup (multi-tenant SaaS). Off for a single firm.
ALLOW_FIRM_SIGNUP=false
